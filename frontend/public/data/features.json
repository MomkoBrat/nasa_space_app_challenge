{
  "schema_version": "1.0",
  "mission_mode": "rover_mobility",
  "regional_analysis": {
    "window_size_m": 10000,
    "analysis_resolution_m": 460,
    "steep_threshold_deg": 15,
    "roughness_smoothing_m": 3000
  },
  "feature_keys": ["median_slope_deg", "steep_fraction", "relief_m", "roughness_m"],
  "normalization_scales": {
    "median_slope_deg": 30,
    "steep_fraction": 1,
    "relief_m": 2000,
    "roughness_m": 200
  },
  "default_weights": {
    "median_slope_deg": 0.25,
    "steep_fraction": 0.30,
    "relief_m": 0.20,
    "roughness_m": 0.25
  },
  "earth_filters": {
    "min_nonvegetated_fraction": 0.70,
    "min_dem_coverage_fraction": 0.90
  },
  "ranking": {
    "distance": "weighted_euclidean",
    "display_score": "100/(1+distance)",
    "default_results": 10,
    "min_separation_km": 50
  },
  "notes": "Normalization scales and weights are engineering defaults, not scientifically calibrated. Albedo and geology excluded from quantitative matching in v1."
}
