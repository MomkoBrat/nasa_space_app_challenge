{
  "schema_version": "1.0",
  "mission_mode": "rover_mobility",
  "regional_analysis": {
    "window_size_m": 10000,
    "analysis_resolution_m": 460,
    "steep_threshold_deg": 15,
    "roughness_smoothing_m": 1000
  },
  "feature_keys": ["median_slope_deg", "steep_fraction", "relief_m", "roughness_m", "mean_wind_speed_ms"],
  "normalization_scales": {
    "median_slope_deg": 3,
    "steep_fraction": 0.1,
    "relief_m": 250,
    "roughness_m": 25,
    "mean_wind_speed_ms": 1
  },
  "default_weights": {
    "median_slope_deg": 0.25,
    "steep_fraction": 0.30,
    "relief_m": 0.20,
    "roughness_m": 0.25,
    "mean_wind_speed_ms": 0
  },
  "earth_filters": {
    "min_nonvegetated_fraction": 0.70,
    "min_dem_coverage_fraction": 0.90
  },
  "ranking": {
    "distance": "weighted_euclidean",
    "display_score": "100/(1+distance)",
    "default_results": 10,
    "min_separation_km": 50
  },
  "notes": "Normalization scales = rounded standard deviation of each feature across the 17,735 eligible Earth cells; weights are engineering defaults, not scientifically calibrated. Mean wind speed (MACDA on Mars, MERRA-2 SPEED on Earth, both lowest model layer) is an optional 5th feature with default weight 0. Albedo, thermal inertia, pressure and geology are context only."
}
